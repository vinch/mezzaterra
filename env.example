PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optionnel — envoi des campagnes email depuis /manage/campaigns (https://resend.com)
RESEND_API_KEY=
CAMPAIGN_FROM="Mezzaterra <bonjour@votre-domaine.be>"

# Optionnel — formulaire de contact /contact (utilise aussi RESEND_API_KEY)
# Expéditeur sur un domaine vérifié chez Resend (à défaut : CAMPAIGN_FROM) et destinataire.
CONTACT_FROM="Mezzaterra <contact@votre-domaine.be>"
CONTACT_TO=gianni@mezzaterra.be
# Enregistrement des messages de contact (page Demandes de la gestion). Clé service_role :
# serveur uniquement, jamais préfixée PUBLIC_. Sans elle, les messages partent seulement par email.
SUPABASE_SERVICE_ROLE_KEY=
# CAPTCHA Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) — les deux ensemble.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
